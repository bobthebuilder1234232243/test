<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>ConsentText</key>
    <dict>
        <key>default</key>
        <string>
            Profile 3: Certificate Revoke Blocker (VPN-Resilient)

            This profile attempts to block certificate revocation checks even when a VPN is active by using a split-DNS VPN payload. It forces only the OCSP/CRL domains through a non-functional DNS server, while all other traffic is handled normally.

            • Uses VPN On-Demand with Split DNS (NEDNSSettings).
            • Works against on-demand VPNs and standard third-party VPNs.
            • May NOT work if an Always-On VPN is installed or if the VPN is a full-tunnel that ignores split-DNS settings.

            ⚠️ Warning: Blocking certificate revocation checks prevents your device from detecting revoked or compromised certificates. This is a security risk. Use at your own risk.

            DNS Mobile Configuration By: Nexus Signer
        </string>
    </dict>

    <key>PayloadContent</key>
    <array>
        <!-- VPN Payload with Split DNS (NEDNSSettings) -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.vpn.managed</string>
            <key>PayloadIdentifier</key>
            <string>com.nexus.vpn.crblocker.A1B2C3D4-0004-0004-0004-000000000001</string>
            <key>PayloadUUID</key>
            <string>A1B2C3D4-0004-0004-0004-000000000001</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadDisplayName</key>
            <string>VPN-Resilient CR Blocker</string>

            <!-- VPN Sub-Type: IKEv2 is used as a harmless carrier -->
            <key>VPNSubType</key>
            <string>com.apple.ikev2</string>
            <key>VPNType</key>
            <string>IKEv2</string>

            <!-- IKEv2 Connection Settings (Placeholder - does not need to connect) -->
            <key>IKEv2</key>
            <dict>
                <key>RemoteAddress</key>
                <string>127.0.0.1</string>
                <key>LocalIdentifier</key>
                <string>nexus-cr-blocker</string>
                <key>RemoteIdentifier</key>
                <string>nexus-cr-blocker</string>
                <key>AuthenticationMethod</key>
                <string>None</string>
            </dict>

            <!-- Split DNS: Capture ONLY the revocation domains -->
            <key>DNS</key>
            <dict>
                <key>ServerAddresses</key>
                <array>
                    <!-- Blackhole DNS: resolves to nothing -->
                    <string>192.0.2.1</string>
                    <string>192.0.2.2</string>
                </array>
                <key>SupplementalMatchDomains</key>
                <array>
                    <!-- Apple OCSP -->
                    <string>ocsp.apple.com</string>
                    <string>ocsp2.apple.com</string>
                    <string>ocsp-lb.apple.com</string>
                    <string>ocsp2-lb.apple.com</string>
                    <string>ocsp2-lb.apple.com.akadns.net</string>
                    <string>ocsp2.g.aaplimg.com</string>
                    <!-- Apple CRL -->
                    <string>crl.apple.com</string>
                    <string>crl2.apple.com</string>
                    <string>crl3.apple.com</string>
                    <!-- Apple Certificate Validation -->
                    <string>valid.apple.com</string>
                    <string>certs.apple.com</string>
                    <string>ppq.apple.com</string>
                    <string>appattest.apple.com</string>
                    <string>vpp.itunes.apple.com</string>
                    <string>gdmf.apple.com</string>
                    <!-- DigiCert OCSP -->
                    <string>ocsp.digicert.com</string>
                    <string>ocsp.digicert.cn</string>
                    <!-- DigiCert CRL -->
                    <string>crl.digicert.com</string>
                    <string>crl2.digicert.com</string>
                    <string>crl3.digicert.com</string>
                    <string>crl4.digicert.com</string>
                    <string>crl5.digicert.com</string>
                </array>
            </dict>

            <!-- On-Demand Rules: Keep the VPN carrier alive -->
            <key>OnDemandEnabled</key>
            <integer>1</integer>
            <key>OnDemandRules</key>
            <array>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
                    <string>WiFi</string>
                </dict>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
                    <string>Cellular</string>
                </dict>
            </array>
        </dict>
    </array>

    <key>PayloadDescription</key>
    <string>
        Profile 3: Certificate Revoke Blocker (VPN-Resilient)

        This profile uses a VPN payload with Split DNS (NEDNSSettings) to attempt to force revocation queries to a blackhole DNS server. It is designed to be more resilient against VPN DNS overrides than a standalone DNS Proxy.

        • Uses a non-routing IKEv2 VPN as a carrier for the DNS settings.
        • Only the listed OCSP/CRL domains are forced through the blackhole DNS.
        • All other DNS traffic is handled normally by the system or an active VPN.

        ⚠️ This profile may NOT work if:
        - An Always-On VPN is installed (iOS will terminate this profile).
        - The user's VPN is a full-tunnel that ignores split-DNS settings.

        ⚠️ Disabling certificate revocation checks is a significant security risk. Use with caution.
    </string>

    <key>PayloadDisplayName</key>
    <string>CR Blocker (VPN-Resilient)</string>
    <key>PayloadIdentifier</key>
    <string>com.nexus.config.cr-vpnresilient</string>
    <key>PayloadOrganization</key>
    <string>Nexus - Mobile Configuration</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>B2C3D4E5-0004-0004-0004-000000000001</string>
    <key>PayloadVersion</key>
    <integer>1</integer>

    <key>ProhibitDisablement</key>
    <false/>
</dict>
</plist>
