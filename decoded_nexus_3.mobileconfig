<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>ConsentText</key>
    <dict>
        <key>default</key>
        <string>
            ⚠️ WARNING: STATUS BAR GLITCH ⚠️


            ❗ NOTE: IF IT ASKS FOR USERNAME AND/OR PASSWORD THEN JUST ENTER ANYTHING ❗


            Profile 3: Certificate Revoke Blocker (VPN-Resilient)

            This profile uses a dummy VPN tunnel to enforce split-DNS blocking. This allows it to bypass other VPNs and block certificate revocation checks.

            PLEASE NOTE: Because this creates a VPN tunnel, iOS may hide your Wi-Fi icon in the status bar (a known iOS bug). 


            • VPN-Proof: Blocks work even if you connect a third-party VPN.
            • MIGHT NOT WORK ON ALWAYS-ON VPN

            ⚠️ Warning: Disabling certificate revocation checks is a serious security risk. Use at your own risk.

            DNS Mobile Configuration By: Nexus Signer
        </string>
    </dict>

    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.apple.vpn.managed</string>
            <key>PayloadIdentifier</key>
            <string>com.nexus.vpn.crblocker.A1B2C3D4-0004-0004-0004-000000000001</string>
            <key>PayloadUUID</key>
            <string>A1B2C3D4-0004-0004-0004-000000000001</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadDisplayName</key>
            <string>VPN-Resilient CR Blocker</string>

            <key>VPNSubType</key>
            <string>com.apple.ikev2</string>
            <key>VPNType</key>
            <string>IKEv2</string>

            <key>IKEv2</key>
            <dict>
                <key>RemoteAddress</key>
                <string>127.0.0.1</string>
                <key>LocalIdentifier</key>
                <string>nexus-cr-blocker</string>
                <key>RemoteIdentifier</key>
                <string>nexus-cr-blocker</string>
                <key>AuthenticationMethod</key>
                <string>None</string>
                <key>ExtendedAuthEnabled</key>
                <integer>1</integer>
            </dict>

            <key>DNS</key>
            <dict>
                <key>ServerAddresses</key>
                <array>
                    <string>192.0.2.1</string>
                    <string>192.0.2.2</string>
                </array>
                <key>SupplementalMatchDomains</key>
                <array>
                    <!-- Apple OCSP -->
                    <string>ocsp.apple.com</string>
                    <string>ocsp2.apple.com</string>
                    <string>ocsp-lb.apple.com</string>
                    <string>ocsp2-lb.apple.com</string>
                    <string>ocsp2-lb.apple.com.akadns.net</string>
                    <string>ocsp2.g.aaplimg.com</string>
                    <!-- Apple CRL -->
                    <string>crl.apple.com</string>
                    <string>crl2.apple.com</string>
                    <string>crl3.apple.com</string>
                    <!-- Apple Certificate Validation -->
                    <string>valid.apple.com</string>
                    <string>certs.apple.com</string>
                    <string>ppq.apple.com</string>
                    <string>appattest.apple.com</string>
                    <string>vpp.itunes.apple.com</string>
                    <string>gdmf.apple.com</string>
                    <!-- DigiCert OCSP -->
                    <string>ocsp.digicert.com</string>
                    <string>ocsp.digicert.cn</string>
                    <!-- DigiCert CRL -->
                    <string>crl.digicert.com</string>
                    <string>crl2.digicert.com</string>
                    <string>crl3.digicert.com</string>
                    <string>crl4.digicert.com</string>
                    <string>crl5.digicert.com</string>
                </array>
            </dict>

            <key>OnDemandEnabled</key>
            <integer>1</integer>
            <key>OnDemandRules</key>
            <array>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
                    <string>WiFi</string>
                </dict>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
                    <string>Cellular</string>
                </dict>
            </array>
        </dict>
    </array>

    <key>PayloadDescription</key>
    <string>Profile 3: Certificate Revoke Blocker (VPN-Resilient). Uses a split-DNS VPN carrier. Note: iOS may hide the Wi-Fi icon in the status bar.</string>
    <key>PayloadDisplayName</key>
    <string>CR Blocker (VPN-Resilient)</string>
    <key>PayloadIdentifier</key>
    <string>com.nexus.config.cr-vpnresilient</string>
    <key>PayloadOrganization</key>
    <string>Nexus - Mobile Configuration</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>B2C3D4E5-0004-0004-0004-000000000001</string>
    <key>PayloadVersion</key>
    <integer>1</integer>

    <key>ProhibitDisablement</key>
    <false/>
</dict>
</plist>
