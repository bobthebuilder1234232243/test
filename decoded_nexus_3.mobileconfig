<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>ConsentText</key>
    <dict>
        <key>default</key>
        <string>
            Profile 3: Certificate Revoke Blocker (VPN-Resilient)

            This profile blocks certificate revocation checks even when a VPN is active by using a DNS Proxy payload. It forces only the OCSP/CRL domains through a non-functional DNS server, while all other traffic is handled normally.

            • Uses DNS Proxy to avoid the VPN status bar glitch (Wi-Fi icon stays visible).
            • No Shared Secret prompt required.
            • Works against standard third-party VPNs.
            • May NOT work if an Always-On VPN is installed.

            ⚠️ Warning: Blocking certificate revocation checks prevents your device from detecting revoked or compromised certificates. This is a security risk. Use at your own risk.

            DNS Mobile Configuration By: Wen Zhang
        </string>
    </dict>

    <key>PayloadContent</key>
    <array>
        <!-- DNS Proxy Payload -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.dnsProxy.managed</string>
            <key>PayloadIdentifier</key>
            <string>com.nexus.dnsproxy.crblocker.A1B2C3D4-0004-0004-0004-000000000001</string>
            <key>PayloadUUID</key>
            <string>A1B2C3D4-0004-0004-0004-000000000001</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadDisplayName</key>
            <string>VPN-Resilient CR Blocker (DNS Proxy)</string>

            <key>AppBundleIdentifier</key>
            <string>com.apple.Preferences</string>
            <key>ProviderBundleIdentifier</key>
            <string>com.apple.Preferences</string>
            
            <key>ProviderConfiguration</key>
            <dict>
                <key>ServerURL</key>
                <string>https://localhost.direct</string>
                <key>BlockedDomains</key>
                <array>
                    <!-- Apple OCSP -->
                    <string>ocsp.apple.com</string>
                    <string>ocsp2.apple.com</string>
                    <string>ocsp-lb.apple.com</string>
                    <string>ocsp2-lb.apple.com</string>
                    <string>ocsp2-lb.apple.com.akadns.net</string>
                    <string>ocsp2.g.aaplimg.com</string>
                    <!-- Apple CRL -->
                    <string>crl.apple.com</string>
                    <string>crl2.apple.com</string>
                    <string>crl3.apple.com</string>
                    <!-- Apple Certificate Validation -->
                    <string>valid.apple.com</string>
                    <string>certs.apple.com</string>
                    <string>ppq.apple.com</string>
                    <string>appattest.apple.com</string>
                    <string>vpp.itunes.apple.com</string>
                    <string>gdmf.apple.com</string>
                    <!-- DigiCert OCSP -->
                    <string>ocsp.digicert.com</string>
                    <string>ocsp.digicert.cn</string>
                    <!-- DigiCert CRL -->
                    <string>crl.digicert.com</string>
                    <string>crl2.digicert.com</string>
                    <string>crl3.digicert.com</string>
                    <string>crl4.digicert.com</string>
                    <string>crl5.digicert.com</string>
                </array>
            </dict>

            <key>OnDemandRules</key>
            <array>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
                    <string>WiFi</string>
                </dict>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
                    <string>Cellular</string>
                </dict>
            </array>
        </dict>
    </array>

    <key>PayloadDescription</key>
    <string>
        Profile 3: Certificate Revoke Blocker (VPN-Resilient)

        Uses a DNS Proxy payload to force the listed OCSP/CRL domains through a blackhole DNS. All other DNS traffic is handled normally. This method avoids the VPN status bar glitch that can hide the Wi-Fi icon and requires no password.

        ⚠️ This profile may NOT work if an Always-On VPN is installed.
        ⚠️ Disabling certificate revocation checks is a significant security risk.
    </string>

    <key>PayloadDisplayName</key>
    <string>CR Blocker (VPN-Resilient)</string>
    <key>PayloadIdentifier</key>
    <string>com.nexus.config.cr-vpnresilient</string>
    <key>PayloadOrganization</key>
    <string>Nexus - Mobile Configuration</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>B2C3D4E5-0004-0004-0004-000000000001</string>
    <key>PayloadVersion</key>
    <integer>1</integer>

    <key>ProhibitDisablement</key>
    <false/>
</dict>
</plist>
