    <key>PayloadDescription</key>
    <string>
        ⚠️⚠️⚠️ PROFILE 5: COMPLETE APPLE SERVICE BLACKOUT ⚠️⚠️⚠️

        This profile blocks over 130 Apple domains, effectively cutting your device off from nearly all Apple services. This includes, but is not limited to:

        ❌ iCloud (all sync, Drive, Photos, Backup)
        ❌ App Store &amp; iTunes
        ❌ iMessage &amp; FaceTime
        ❌ Push Notifications
        ❌ Siri &amp; Dictation
        ❌ Apple Maps
        ❌ Find My iPhone
        ❌ Apple Pay &amp; Wallet
        ❌ Game Center
        ❌ Weather, Stocks, News
        ❌ Software Updates
        ❌ Device Activation
        ❌ Apple ID &amp; Authentication
        ❌ All CDN &amp; Edge content delivery

        🔴 THIS PROFILE IS PROVIDED FOR REFERENCE ONLY.
        DO NOT INSTALL unless you fully understand that your device will become extremely limited and essentially unusable for normal daily functions. Certificate validation is also blocked (same as Profile 1), creating a security risk.

        You have been warned.
    </string>

    <key>PayloadDisplayName</key>
    <string>☠️ ALL Apple Domains Blocked</string>
    <key>PayloadIdentifier</key>
    <string>com.nexus.config.all-apple-block</string>
    <key>PayloadOrganization</key>
    <string>Nexus - Mobile Configuration</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>B2C3D4E5-0005-0005-0005-000000000001</string>
    <key>PayloadVersion</key>
    <integer>1</integer>

    <key>ProhibitDisablement</key>
    <false/>
</dict>
</plist>
