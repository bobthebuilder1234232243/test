<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>ConsentText</key>
    <dict>
        <key>default</key>
        <string>
            Profile 2: Certificate Revoke Blocker + Ad Blocker

            Blocks all known Apple certificate revocation servers AND a curated list of major ad/tracking domains. All other DNS traffic resolves through Cloudflare (1.1.1.1) for speed and privacy.

            • Certificate revoke protection (same comprehensive list as Profile 1)
            • Ad &amp; tracker blocking via local sinkhole (no third-party ad-block DNS)

            ⚠️ Warning: Blocking certificate revocation checks prevents detection of revoked certificates. Ad blocking may break some apps or websites. Use at your own risk.

            DNS Mobile Configuration By: Wen Zhang
        </string>
    </dict>

    <key>PayloadContent</key>
    <array>
        <!-- Payload 1: Sinkhole for Revocation + Ad Domains -->
        <dict>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <key>ServerURL</key>
                <string>https://localhost.direct</string>
                <key>SupplementalMatchDomains</key>
                <array>
                    <!-- ===== Apple Certificate Revocation (Profile 1 comprehensive list) ===== -->
                    <string>ocsp.apple.com</string>
                    <string>ocsp2.apple.com</string>
                    <string>ocsp-lb.apple.com</string>
                    <string>ocsp2-lb.apple.com</string>
                    <string>ocsp2-lb.apple.com.akadns.net</string>
                    <string>ocsp2.g.aaplimg.com</string>
                    <string>crl.apple.com</string>
                    <string>crl2.apple.com</string>
                    <string>crl3.apple.com</string>
                    <string>valid.apple.com</string>
                    <string>certs.apple.com</string>
                    <string>ppq.apple.com</string>
                    <string>appattest.apple.com</string>
                    <string>vpp.itunes.apple.com</string>
                    <string>gdmf.apple.com</string>
                    <string>ocsp.digicert.com</string>
                    <string>ocsp.digicert.cn</string>
                    <string>crl.digicert.com</string>
                    <string>crl2.digicert.com</string>
                    <string>crl3.digicert.com</string>
                    <string>crl4.digicert.com</string>
                    <string>crl5.digicert.com</string>

                    <!-- ===== Ad &amp; Tracking Domains ===== -->
                    <!-- Google Ads &amp; Analytics -->
                    <string>doubleclick.net</string>
                    <string>googlesyndication.com</string>
                    <string>googleadservices.com</string>
                    <string>adservice.google.com</string>
                    <string>pagead2.googlesyndication.com</string>
                    <string>googletagmanager.com</string>
                    <string>googletagservices.com</string>
                    <string>analytics.google.com</string>
                    <!-- Facebook Tracking -->
                    <string>pixel.facebook.com</string>
                    <string>an.facebook.com</string>
                    <string>sb.facebook.com</string>
                    <!-- Amazon Ads -->
                    <string>amazon-adsystem.com</string>
                    <string>aax-us-east.amazon-adsystem.com</string>
                    <!-- Major Ad Exchanges &amp; SSPs -->
                    <string>adnxs.com</string>
                    <string>adsrvr.org</string>
                    <string>criteo.com</string>
                    <string>criteo.net</string>
                    <string>moatads.com</string>
                    <string>scorecardresearch.com</string>
                    <string>quantserve.com</string>
                    <string>outbrain.com</string>
                    <string>taboola.com</string>
                    <string>doubleverify.com</string>
                    <string>adsafeprotected.com</string>
                    <!-- Mobile Attribution &amp; Analytics -->
                    <string>app-measurement.com</string>
                    <string>app.link</string>
                    <string>adjust.com</string>
                    <string>adjust.io</string>
                    <string>appsflyer.com</string>
                    <string>branch.io</string>
                    <string>mixpanel.com</string>
                    <string>amplitude.com</string>
                    <string>segment.com</string>
                    <string>segment.io</string>
                    <string>braze.com</string>
                    <string>leanplum.com</string>
                    <string>mparticle.com</string>
                    <string>clevertap.com</string>
                    <string>crashlytics.com</string>
                    <string>flurry.com</string>
                    <string>onesignal.com</string>
                    <string>gameanalytics.com</string>
                    <!-- Mobile Ad Networks -->
                    <string>unityads.unity3d.com</string>
                    <string>vungle.com</string>
                    <string>chartboost.com</string>
                    <string>inmobi.com</string>
                    <string>ironsrc.com</string>
                    <string>supersonicads.com</string>
                    <string>fyber.com</string>
                    <string>heyzap.com</string>
                    <string>startappservice.com</string>
                    <string>applovin.com</string>
                    <string>tapjoy.com</string>
                    <string>tapjoyads.com</string>
                    <string>mopub.com</string>
                    <string>smaato.net</string>
                    <string>adcolony.com</string>
                    <string>ogury.co</string>
                </array>
            </dict>

            <key>OnDemandRules</key>
            <array>
                <dict>
                    <key>InterfaceTypeMatch</key>
                    <string>WiFi</string>
                    <key>Action</key>
                    <string>Connect</string>
                </dict>
                <dict>
                    <key>InterfaceTypeMatch</key>
                    <string>Cellular</string>
                    <key>Action</key>
                    <string>Connect</string>
                </dict>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                </dict>
            </array>

            <key>PayloadDisplayName</key>
            <string>CR + Ad Sinkhole</string>
            <key>PayloadIdentifier</key>
            <string>com.apple.dnsSettings.managed.A1B2C3D4-0002-0002-0002-000000000002</string>
            <key>PayloadOrganization</key>
            <string>Nexus - Mobile Configuration</string>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadUUID</key>
            <string>A1B2C3D4-0002-0002-0002-000000000002</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
        </dict>

        <!-- Payload 2: Cloudflare DNS for All Other Traffic -->
        <dict>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <key>ServerURL</key>
                <string>https://1.1.1.1/dns-query</string>
            </dict>

            <key>OnDemandRules</key>
            <array>
                <dict>
                    <key>InterfaceTypeMatch</key>
                    <string>WiFi</string>
                    <key>Action</key>
                    <string>Connect</string>
                </dict>
                <dict>
                    <key>InterfaceTypeMatch</key>
                    <string>Cellular</string>
                    <key>Action</key>
                    <string>Connect</string>
                </dict>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                </dict>
            </array>

            <key>PayloadDisplayName</key>
            <string>Cloudflare DNS (Default)</string>
            <key>PayloadIdentifier</key>
            <string>com.apple.dnsSettings.managed.A1B2C3D4-0002-0002-0002-000000000003</string>
            <key>PayloadOrganization</key>
            <string>Nexus - Mobile Configuration</string>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadUUID</key>
            <string>A1B2C3D4-0002-0002-0002-000000000003</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
        </dict>
    </array>

    <key>PayloadDescription</key>
    <string>
        Profile 2: Certificate Revoke Blocker + Ad Blocker

        • Certificate Revocation Protection: Blocks all known Apple OCSP/CRL/certificate validation servers (same comprehensive list as Profile 1).
        • Ad &amp; Tracker Blocking: Blocks 60+ major ad, tracking, and mobile attribution domains via local sinkhole. No third-party ad-block DNS used — all filtering is done locally.
        • Default DNS: All other domains resolve through Cloudflare (1.1.1.1) for fast, private DNS.

        ⚠️ Ad blocking may cause some apps or websites to behave unexpectedly. Certificate revocation blocking is a security risk.
    </string>

    <key>PayloadDisplayName</key>
    <string>CR + Ad Blocker</string>
    <key>PayloadIdentifier</key>
    <string>com.nexus.config.cr-adblock</string>
    <key>PayloadOrganization</key>
    <string>Nexus - Mobile Configuration</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>B2C3D4E5-0002-0002-0002-000000000001</string>
    <key>PayloadVersion</key>
    <integer>1</integer>

    <key>ProhibitDisablement</key>
    <false/>
</dict>
</plist>
